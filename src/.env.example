APP_NAME="Intechral Client Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:4242
INERTIA_SSR_ENABLED=false
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portal
DB_USERNAME=portal
DB_PASSWORD=portal

# ── Cache & Sessions ──────────────────────────────────────
BROADCAST_CONNECTION=log
CACHE_STORE=redis
CACHE_PREFIX=portal_

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queue ─────────────────────────────────────────────────
QUEUE_CONNECTION=redis
# Database-queue reservation (seconds). Keep it above the worker --timeout plus an allowance for blocking I/O; see
# docs/architecture/notification-delivery.md section 4. Default 300, subject to production host validation.
DB_QUEUE_RETRY_AFTER=300

# ── Redis ─────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
# SMTP socket timeout in seconds: a per-read idle limit, not a total bound on a send (a silent server costs about twice it).
# Not a positive number falls back to 20. Also applies to the synchronous password-reset mail.
MAIL_TIMEOUT=20
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@intechral.solutions"
MAIL_FROM_NAME="${APP_NAME}"

# ── Release 0.9 customer surface (R0.9-CS1) ───────────────
# closed (default) | pilot | legacy. Missing, empty or unrecognised means closed. `legacy` is honoured only when
# APP_ENV is local or testing; elsewhere it resolves to closed and logs a warning. A pilot deployment sets `pilot`
# AND must have run `php artisan roles:sync` so the operator role holds portal.operator, or operators are treated as
# customers. docs/architecture/customer-pilot-surface.md
PORTAL_CUSTOMER_SURFACE_MODE=closed

# ── OpenID / Socialite ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URL="${APP_URL}/auth/microsoft/callback"

# ── Stripe ────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── File Storage ──────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ──────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
