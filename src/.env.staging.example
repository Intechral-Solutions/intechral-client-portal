# Intechral Client Portal: STAGING environment template (Release 0.9, WP3-B2).
#
# This file is a TEMPLATE. It holds no secret. The real file is created by the owner on their own machine, copied to the host over
# SSH as `shared/.env` (mode 0600; each release links to it by symlink, never a copy) and NEVER committed, pasted into chat or put in a
# release archive. Keep your working copy outside the repository, mode 0600.
# Procedure: docs/operations/staging-first-install.md. The settings that decide the production shape (environment, debug, URL, key, database,
# cache, session, queue, mail transport and sender) are checked by RuntimeProfile (src/app/Support/Runtime/RuntimeProfile.php), which
# `php artisan runtime:preflight` and the worker/scheduler startup guard enforce; the others (names, logging, locale) are not.
#
# Every placeholder is an upper-case token with a double underscore on each side (for example, the one in APP_URL). Replace them all; then
#     grep -nE '__[A-Z0-9_]+__' .env
# must print nothing before the file leaves your machine. RuntimeProfile would catch an unfilled APP_KEY, MAIL_PORT, MAIL_FROM_ADDRESS or HELPDESK_NOTIFY_ADDRESS, but NOT an
# unfilled APP_URL, DB_DATABASE, DB_USERNAME, DB_PASSWORD, MAIL_HOST, MAIL_USERNAME or MAIL_PASSWORD (measured), so the grep is the control for those.
#
# Staging is isolated from the eventual production portal and from every existing resource on the account: its own hostname,
# database and database user, storage, APP_KEY, cache prefix and session cookie. APP_ENV is deliberately `production`: only then do the
# migration guard, the A1 profile and the A3 startup guard apply the way they will for the real release.

# ── Application ───────────────────────────────────────────
# APP_NAME also derives defaults for the cache prefix and session cookie; both are set explicitly below. It appears in the UI and in
# the mail sender name, so make it recognisably staging.
APP_NAME="Intechral Portal Staging"
APP_ENV=production
APP_DEBUG=false
# https only, no trailing slash, not a local address. Queued mail builds its links from it.
APP_URL=https://__STAGING_HOST__
# Unique to staging, never shared with production or development, never reused after teardown.
# Generate on your machine:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=__STAGING_APP_KEY__
# UTC is not configurable (config/app.php); the host's Eastern clock does not change it.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# `file` keeps `php artisan down` working while the database is the thing being repaired.
APP_MAINTENANCE_DRIVER=file
# No Node on the host: server-side rendering stays off.
INERTIA_SSR_ENABLED=false

# ── Logging ───────────────────────────────────────────────
# A protected, bounded file channel. Never stderr: the cron wrapper reads the process's stderr for its failure marker
# (docs/architecture/cron-execution.md, "Marker integrity and where the application logs").
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# ── Database (dedicated staging database and user) ────────
# Created through cPanel by the owner. The user holds privileges on this database only. Neither name may be the name of an existing
# account database, and the database must not be named `intechral_client_portal_testing` (the test-database safety fence).
# `localhost` uses the host's local socket. No DB_URL, DB_SOCKET or *_CONNECTION override: the cache, sessions and queue must share
# the one default connection (RuntimeProfile).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=__STAGING_DB_NAME__
DB_USERNAME=__STAGING_DB_USER__
DB_PASSWORD=__STAGING_DB_PASSWORD__

# ── Cache, sessions, queue: the database is all three ─────
# No Redis on the host and none is referenced. Unique prefix and cookie so nothing can be confused with another environment.
BROADCAST_CONNECTION=log
CACHE_STORE=database
CACHE_PREFIX=portal_staging_

SESSION_DRIVER=database
SESSION_COOKIE=portal_staging_session
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
# Host-only cookie. A parent-domain value would send the staging cookie to every sibling site.
SESSION_DOMAIN=null
# Both must resolve to boolean true (RuntimeProfile); Laravel's default for the Secure flag is unset, which is not enough. Leave as written.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
# Reservation window in seconds. The cron wrapper's worker is gone by 270 s, so 300 is the floor RuntimeProfile enforces.
# Do not lower it; see docs/architecture/cron-execution.md ("Timing and reservation safety").
DB_QUEUE_RETRY_AFTER=300

# ── Mail: an owner-controlled mailbox or sink only ────────
# The transport must be smtp with a real host (not the development sink) and a real sender address (not example.com/.org/.net).
# Outbound mail from staging goes to the owner's sink and nowhere else: never put a customer address into staging.
# Do not set a mail URL variable at all: a URL can replace the transport and credentials, and RuntimeProfile refuses any non-empty one.
# Use the discrete settings below.
# Port 465 uses implicit TLS (or set MAIL_SCHEME=smtps); port 587 negotiates STARTTLS when the server offers it. Confirm with the sink.
MAIL_MAILER=smtp
MAIL_HOST=__SMTP_HOST__
MAIL_PORT=__SMTP_PORT__
MAIL_USERNAME=__SMTP_USERNAME__
MAIL_PASSWORD=__SMTP_PASSWORD__
# Seconds. A per-read idle limit, not a bound on a whole send (docs/architecture/notification-delivery.md).
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS="__MAIL_FROM_ADDRESS__"
MAIL_FROM_NAME="${APP_NAME}"
# The operator new-ticket alert (EPIC-017 O3, RE-H13): ONE mailbox, told when a customer raises a request. Required: this installation runs
# APP_ENV=production, so RuntimeProfile refuses it unset or malformed, and the cron workers then refuse to start. Set it BEFORE the
# configuration is cached for the release (an uncached or stale cache is refused too). On staging, use an owner-controlled address that the
# mail sink above captures; never a customer's or a real operator inbox you do not own. It must not be an example.com/.org/.net address.
# Configuration proves the address is well formed, not that mail reaches it: the first real alert does (docs/architecture/notification-delivery.md).
HELPDESK_NOTIFY_ADDRESS="__HELPDESK_NOTIFY_ADDRESS__"

# ── Release 0.9 customer surface ──────────────────────────
# `closed` (customers see nothing) until roles:sync has been applied and the first operator exists; the first-install runbook then
# sets `pilot` and re-caches the configuration BEFORE the site is selected. `legacy` is not honoured outside local/testing.
# Customer Helpdesk, accounts/Home and secure project visibility only; finance, time tracking and task boards stay excluded
# server-side by this mode (docs/architecture/customer-pilot-surface.md).
PORTAL_CUSTOMER_SURFACE_MODE=closed

# ── Storage ───────────────────────────────────────────────
# Attachments use the private `local` disk (storage/app/private). Nothing is served from a public disk, so there is no storage:link.
FILESYSTEM_DISK=local

# ── Deliberately NOT set ──────────────────────────────────
# Stripe (STRIPE_*), Google/Microsoft sign-in (GOOGLE_*, MICROSOFT_*), AWS/S3 (AWS_*), Redis (REDIS_*), Slack, Postmark, Resend and every
# *_CONNECTION/DB_CACHE_*/DB_QUEUE_* override. Staging holds no live payment or external-integration credential, and SSO is deferred
# for the first pilot. Do not add a variable here to "try" something; change the template through review.
