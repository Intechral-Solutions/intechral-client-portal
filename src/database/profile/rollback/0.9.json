{
    "version": 1,
    "description": "Reviewed record of EXACTLY what this build adds to the Release 0.9 database schema, for rolling the application code back to the immutable Release 0.9 build. Release 0.9's own verifiers (database:verify, runtime:preflight) compare the live foreign keys with THEIR manifest and cannot be changed, so after a code rollback they report the lines under expected_target_verifier_output and nothing may be added to that list without review. This file does not make the 0.9 verifier pass; it is the explicit, auditable acknowledgement an operator compares its output against. It is deliberately narrow: foreign keys, the ran-migration set, added columns, CHECK constraints and queued classes. See docs/operations/rollback-1.0-to-0.9.md.",
    "target": {
        "release": "0.9",
        "commit": "32ec62f5c034b6394950203941e170d830b4669c",
        "foreign_key_manifest": "database/profile/releases/0.9/foreign-keys.json",
        "foreign_key_manifest_sha256": "c7d20f471ae3e23e762ea4dc55408426a8cef638f1c08d3b74a36e12e754c724",
        "last_migration": "2026_10_12_000003_restrict_company_project_association_deletes",
        "queued_classes": [
            "App\\Jobs\\RecordRuntimeObservation",
            "App\\Notifications\\InvitationNotification",
            "App\\Notifications\\NewTicketAlertNotification",
            "App\\Notifications\\TicketCreatedNotification",
            "App\\Notifications\\TicketRepliedNotification",
            "App\\Notifications\\TicketStatusNotification"
        ],
        "check_constraints": [
            "activity_log.properties"
        ]
    },
    "migrations_after_target": [
        "2026_11_04_120000_add_ticket_due_date_override",
        "2026_11_06_120000_add_organization_management_relationship",
        "2026_11_06_120100_unique_company_organization_link",
        "2026_11_07_090000_add_organization_admin_approval"
    ],
    "additive_foreign_keys": {
        "organization_members.admin_approved_by->users.id": "RESTRICT/RESTRICT",
        "organizations.managed_by_organization_id->organizations.id": "RESTRICT/RESTRICT",
        "ticket_due_date_changes.ticket_id->tickets.id": "CASCADE/RESTRICT",
        "ticket_due_date_changes.ticket_id,reply_id->ticket_replies.ticket_id,id": "CASCADE/RESTRICT",
        "ticket_due_date_changes.user_id->users.id": "SET NULL/RESTRICT"
    },
    "additive_columns": {
        "tickets.due_override_at": {
            "nullable": true,
            "default": null
        },
        "organizations.managed_by_organization_id": {
            "nullable": true,
            "default": null
        },
        "organizations.can_manage_customers": {
            "nullable": false,
            "default": "0"
        },
        "organization_members.admin_approved_at": {
            "nullable": true,
            "default": null
        },
        "organization_members.admin_approved_by": {
            "nullable": true,
            "default": null
        }
    },
    "additive_check_constraints": {
        "organizations.organizations_partner_not_managed_check": "can_manage_customers = 0 or managed_by_organization_id is null. Release 0.9 never writes either column, and the defaults (0 and NULL) satisfy it, so the older code cannot violate it."
    },
    "tightenings": [
        {
            "object": "unique+:crm_companies(organization_id)",
            "reason": "The only writer of crm_companies.organization_id in Release 0.9 is the promotion of a company, which always creates a NEW organization for it, so the older code cannot violate the key."
        },
        {
            "object": "unique+:ticket_replies(ticket_id,id)",
            "reason": "ticket_replies.id is already unique, so a (ticket_id, id) pair cannot repeat."
        }
    ],
    "queued_classes_added_since_target": [],
    "expected_target_verifier_output": [
        "unexpected foreign key: organization_members.admin_approved_by->users.id (RESTRICT/RESTRICT)",
        "unexpected foreign key: organizations.managed_by_organization_id->organizations.id (RESTRICT/RESTRICT)",
        "unexpected foreign key: ticket_due_date_changes.ticket_id,reply_id->ticket_replies.ticket_id,id (CASCADE/RESTRICT)",
        "unexpected foreign key: ticket_due_date_changes.ticket_id->tickets.id (CASCADE/RESTRICT)",
        "unexpected foreign key: ticket_due_date_changes.user_id->users.id (SET NULL/RESTRICT)"
    ]
}
