{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "lint": "eslint 'resources/js/**/*.{ts,tsx}' vite.config.ts playwright.config.ts --max-warnings=0",
        "lint:fix": "eslint 'resources/js/**/*.{ts,tsx}' vite.config.ts playwright.config.ts --fix",
        "format": "prettier --write 'resources/js/**/*.{ts,tsx}' vite.config.ts playwright.config.ts",
        "format:check": "prettier --check 'resources/js/**/*.{ts,tsx}' vite.config.ts playwright.config.ts",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "wayfinder:generate": "php artisan route:clear && php artisan wayfinder:generate --with-form",
        "check": "npm run wayfinder:generate && npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@playwright/test": "^1.63.0",
        "@shadcn/lint": "0.2.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^22.20.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "axios": "^1.11.0",
        "chart.js": "^4.4.0",
        "chartjs-plugin-dragdata": "^2.2.5",
        "concurrently": "^9.0.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "jsdom": "^30.1.0",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.9.7",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@inertiajs/react": "^3.7.1",
        "@inertiajs/vite": "^3.7.1",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.47.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0"
    }
}
